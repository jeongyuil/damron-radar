# 복사해서 .env로 사용: cp .env.example .env  (.env는 절대 커밋 금지)
DATABASE_URL=postgresql://damron:damron-dev@localhost:5432/damron
POSTGRES_PASSWORD=damron-dev

# Anthropic — 구조화(Haiku 4.5)·검증(Sonnet 5). dev/prod 키 분리 발급 (D3)
ANTHROPIC_API_KEY=

# YouTube Data API v3 — 업로드 감지·메타데이터 (§4). search.list 사용 금지 원칙
YOUTUBE_API_KEY=

# Groq — Whisper large-v3-turbo STT (§5, D2 기본안)
GROQ_API_KEY=

# Telegram — 장애 알림·데일리 요약 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
